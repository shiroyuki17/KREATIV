// Prisma 7.8 — Rust-free `prisma-client` generator
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Анхаар: url ЭНД БАЙХГҮЙ. Prisma 7-д prisma.config.ts руу шилжсэн.
}

// ── Auth ──

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Google-ээр нэвтэрсэн хэрэглэгч нууц үг огт тохируулаагүй байж болно
  passwordHash String?
  name         String?
  phone        String?  @unique
  avatarUrl    String?
  googleId     String?  @unique
  role         Role     @default(USER)
  isActive     Boolean  @default(true)

  // FR-1.1: утасны OTP баталгаажуулалт — жинхэнэ SMS gateway байхгүй тул демо
  // горимоор ажиллана (kod-ыг sendMail-ийн адил "илгээгээд" хариултад буцаана).
  phoneOtpHash      String?
  phoneOtpExpiresAt DateTime?

  // "Forgot password" — sha256(token) хадгална, түр зуурын (30 мин)
  passwordResetHash      String?
  passwordResetExpiresAt DateTime?
  phoneVerifiedAt   DateTime?

  refreshTokens     RefreshToken[]
  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?
  subscription      Subscription?
  transactions      Transaction[]
  notifications     Notification[]
  sentMessages       Message[]
  conversationsAsA   Conversation[]   @relation("ConversationsAsA")
  conversationsAsB   Conversation[]   @relation("ConversationsAsB")
  disputesOpened     Dispute[]
  reviewsGiven       Review[]         @relation("ReviewsGiven")
  reviewsReceived    Review[]         @relation("ReviewsReceived")
  blocksMade         Block[]          @relation("BlocksMade")
  blocksReceived     Block[]          @relation("BlocksReceived")
  following          Follow[]         @relation("Following")
  followers          Follow[]         @relation("Followers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Хэрэглэгч нөгөөг нь блоклох. Хоёр тал ХОЁУЛАА бие биедээ бичихээ болино
// (нэг талын блок хангалттай) — жагсаалт нь чиглэлтэй ч хэрэгжилт нь
// хоёр чиглэлд шалгадаг.
model Block {
  id        String   @id @default(uuid())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Мэргэжилтнийг "дагах" — дараа хөлслөхөөр хадгалж авах хавчуурга. Чиглэлтэй
// (дагасан хүн ↔ дагагдсан хүн), хоёр талын зөвшөөрөл шаардахгүй.
model Follow {
  id          String   @id @default(uuid())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  // Token-ийн hash-ийг хадгална (token-ийг шууд DB-д хадгалахгүй)
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

// ── Profiles ──
// Нэг User account зэрэг Freelancer БА Client профайлтай байж болно
// (хоёулаа заавал биш, optional 1:1 хамаарал).

model FreelancerProfile {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  headline      String?
  bio           String?
  category      String?
  skills        String[] @default([])
  priceMin      Int?
  priceMax      Int?
  ratingAvg     Float    @default(0)
  jobsCompleted Int      @default(0)

  // FR-5.1: Verified badge — freelancer нотолгоо (portfolio/ID холбоос)
  // илгээж, админ гараар хянаж баталгаажуулдаг бодит урсгал (decorative
  // mock badge биш). AI-аар автоматаар баталгаажуулдаггүй — луйврын эрсдэл
  // өндөр тул зөвхөн хүн шийддэг.
  verificationStatus      VerificationStatus @default(NONE)
  verificationEvidence     String?
  verificationNote        String?
  verificationRequestedAt DateTime?
  verifiedAt               DateTime?

  portfolio PortfolioItem[]
  proposals Proposal[]
  contracts Contract[]
  gigs      Gig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model ClientProfile {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  orgName       String?
  verifiedPayer Boolean  @default(false)
  ratingAvg     Float    @default(0)
  jobsPosted    Int      @default(0)

  jobs      Job[]
  contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioItem {
  id           String            @id @default(uuid())
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId String
  title        String
  description  String?
  images       String[]          @default([])
  link         String?

  createdAt DateTime @default(now())

  @@index([freelancerId])
}

// ── Jobs ──
// FR-2 (PRD): захиалагч ажлын зар нийтэлнэ. ClientProfile-той холбогдсон тул
// зөвхөн client профайлтай хэрэглэгч л зар нийтэлж чадна (RBAC — Day 6).

model Job {
  id          String     @id @default(uuid())
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  title       String
  description String
  category    String
  skills      String[]   @default([])
  languages   String[]   @default([])
  budgetType  BudgetType @default(FIXED)
  budgetMin   Int?
  budgetMax   Int?
  status      JobStatus  @default(OPEN)
  deadline    DateTime?
  // FR-2.3: нийтлэгдэхийн өмнөх автомат шүүлт + админ хяналт. Утас/холбоо
  // барих мэдээлэл илэрсэн зар л PENDING болж, бусад бүгд шууд APPROVED
  // (публик /jobs жагсаалт зөвхөн APPROVED-г харуулна).
  moderationStatus ModerationStatus @default(APPROVED)
  moderationReason String?

  // Gig захиалгаас автоматаар үүссэн бол — тухайн gig-ийн захиалгын
  // тоо/дундаж үнэлгээг тооцоход хэрэглэнэ (доор Gig.jobs харна уу).
  gig   Gig?    @relation(fields: [gigId], references: [id])
  gigId String?

  proposals Proposal[]
  contract  Contract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([clientId])
  @@index([gigId])
}

enum BudgetType {
  FIXED
  HOURLY
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Gigs (Fiverr-маягийн бэлэн үйлчилгээ) ──
// Job/Proposal-ийн эсрэг чиглэл: энд freelancer ӨӨРӨӨ fixed-price
// үйлчилгээгээ урьдчилж зарлаж тавьдаг, client шууд захиалдаг (сонголт
// хийж proposal хүлээхгүй). Захиалга ирэхэд шинэ Job+Proposal-ийг
// доторлогоо талд нь автоматаар үүсгэж, дараа нь ЯГ ХЭВИЙН Contract/
// Milestone/escrow урсгал руу шилждэг — төлбөр/escrow-ын логикийг
// давхардуулахгүй, аль хэдийн шалгагдсан замыг л дахин ашиглана.
model Gig {
  id           String            @id @default(uuid())
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId String
  title        String
  description  String
  category     String
  price        Int
  deliveryDays Int
  images       String[]          @default([])
  active       Boolean           @default(true)

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([freelancerId])
}

// ── Payments ──
// Day 9 (PRD): QPay-тэй жинхэнэ мерчант данс/key байхгүй тул демо горимоор
// ажиллана — deposit нь бодит банкны төлбөрийн оронд гараар "confirm"
// хийгддэг (жинхэнэ webhook ирэхэд confirm-ийн байрыг л түүгээр солино).
model Transaction {
  id          String            @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  kind        TransactionKind
  status      TransactionStatus @default(PENDING)
  amount      Int
  provider    String            @default("qpay_demo")
  // Escrow холбоотой бол — client-ийн ESCROW_HOLD, freelancer-ийн
  // ESCROW_RELEASE хоёул нэг Milestone рүү заана.
  milestone   Milestone?        @relation(fields: [milestoneId], references: [id])
  milestoneId String?
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  // FR-6.3: batlagdsan milestone-ийн ESCROW_RELEASE нь шууд татах боломжтой
  // биш — 5 хоногийн "маргааны цонх" өнгөрсний дараа л available болно.
  // Бусад бүх kind-д null == шууд available (энэ талбар зөвхөн ESCROW_RELEASE-д хэрэглэгдэнэ).
  availableAt DateTime?
  // Жинхэнэ QPay холбогдсон үед invoice/create-ийн буцаасан invoice_id —
  // webhook callback ирэхэд тухайн Transaction-ыг олоход хэрэглэнэ.
  qpayInvoiceId String? @unique
  // Stripe провайдерын эквивалент: Checkout Session-ийн id. Webhook
  // (checkout.session.completed) ирэхэд Transaction-ыг үүгээр олно.
  // QPay/Stripe хоёрыг нэг талбарт хольж хадгалахгүй — webhook-ууд тус
  // тусдаа ирдэг тул хайлт нь тодорхой байх ёстой.
  stripeSessionId String? @unique

  @@index([userId])
  @@index([milestoneId])
}

enum TransactionKind {
  DEPOSIT
  WITHDRAWAL
  ESCROW_HOLD
  ESCROW_RELEASE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// ── Захиалга (Pricing хуудасны Starter/Pro/Enterprise) ──
//
// Өмнө нь Pricing хуудас src/data/mock.js-ийн hardcode жагсаалтыг харуулж,
// товч нь ямар ч onClick-гүй байсан — өөрөөр хэлбэл захиалгын төлбөр огт
// байгаагүй. Багцын тодорхойлолт одоо сервер талд (lib/plans.js) ганц эх
// сурвалжтай; энэ хүснэгт нь хэрэглэгч аль багцад байгааг хадгална.
//
// Stripe-ийн subscription төлөвийг ТОЛЬДОЖ хадгална (эх сурвалж нь Stripe
// хэвээр): webhook бүрд шинэчлэгдэнэ. Ингэснээр эрх шалгах болгонд Stripe
// API руу хандахгүй.
model Subscription {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Нэг хэрэглэгчид нэг л идэвхтэй захиалга.
  userId String @unique

  // "starter" | "pro" | "enterprise" — lib/plans.js-ийн түлхүүр.
  planKey String             @default("starter")
  status  SubscriptionStatus @default(NONE)

  // Stripe-ийн талын танигчид. Provider солигдвол (эсвэл огт байхгүй үед)
  // null хэвээр — планы эрх нь эдгээргүйгээр ч ажиллана.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  // Хамгийн сүүлд эхлүүлсэн Checkout Session. Webhook ирээгүй үед үүгээр
  // Stripe-аас шууд асууж захиалгыг тулгана (lib/subscriptionSync.js).
  stripeCheckoutSessionId String?

  // Одоогийн төлсөн хугацааны төгсгөл — эрх хэдийг хүртэл хүчинтэйг харуулна.
  currentPeriodEnd DateTime?
  // Хэрэглэгч цуцалсан ч хугацааны эцэс хүртэл эрх нь хэвээр үлддэг.
  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum SubscriptionStatus {
  // Хэзээ ч төлбөр хийгээгүй — үнэгүй Starter багц.
  NONE
  // Stripe Checkout эхэлсэн ч webhook хараахан ирээгүй.
  PENDING
  ACTIVE
  // Төлбөр амжилтгүй — Stripe дахин оролдож байна (эрхийг шууд таслахгүй).
  PAST_DUE
  CANCELED
}

// ── Proposals, Contracts, Milestones (PRD FR-3/FR-4 — "гол flow") ──

model Proposal {
  id           String            @id @default(uuid())
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId String
  price        Int
  durationDays Int?
  coverLetter  String
  status       ProposalStatus    @default(PENDING)
  createdAt    DateTime          @default(now())

  contract Contract?

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Contract {
  id            String         @id @default(uuid())
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String         @unique
  proposal      Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId    String         @unique
  client        ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  freelancer    FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId  String
  totalAmount   Int
  commissionPct Int            @default(10)
  // FR-4.4: батлахаас өмнө хэдэн удаа засвар хүсэж болохыг хязгаарлана
  revisionLimit Int            @default(2)
  status        ContractStatus @default(ACTIVE)
  // FR-8.1: хоёулаа review өгөх/14 хоног хүртэл review-ууд "далд" байна —
  // энэ огноог lazy тооцоолохын оронд гэрээ дуусах мөчид тодорхой тэмдэглэнэ.
  completedAt   DateTime?

  milestones  Milestone[]
  reviews     Review[]
  tasks       Task[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([freelancerId])
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Milestone {
  id            String          @id @default(uuid())
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId    String
  title         String
  amount        Int
  order         Int             @default(0)
  status        MilestoneStatus @default(PENDING_FUNDING)
  deliveryNote  String?
  deliveryLink  String?
  deliveredAt   DateTime?
  approvedAt    DateTime?
  fundedAt      DateTime?
  // Хүлээлгэн өгсний дараа 7 хоногийн дотор захиалагч хариу өгөхгүй бол
  // автоматаар батлагдана (FR-4.5) — cron biш, унших мөчид шалгаж
  // "lazy" байдлаар шилждэг (serverless/free-tier hosting-д ч ажиллана).
  autoApproveAt DateTime?
  // FR-4.4: contract.revisionLimit хүрвэл цаашид зөвхөн batlah/dispute нээх боломжтой
  revisionsUsed Int       @default(0)

  transactions Transaction[]
  dispute      Dispute?

  createdAt DateTime @default(now())

  @@index([contractId])
}

enum MilestoneStatus {
  PENDING_FUNDING
  FUNDED
  DELIVERED
  APPROVED
  DISPUTED
}

// FR-3.1: Гэрээ бүрийн Kanban ажлын самбар — Milestone (мөнгөтэй холбоотой,
// эскроу шат) -аас тусдаа, чөлөөтэй нэмэгддэг өдөр тутмын to-do картууд.
// Хоёр тал (client, freelancer) хоёулаа үүсгэж/зөөж болно.
model Task {
  id          String     @id @default(uuid())
  contract    Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId  String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  order       Int        @default(0)
  createdBy   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
}

// ── Цаг бүртгэл ──
//
// Өмнө нь UI-д "42.5h logged / 60h est." гэсэн тоолуур байсан боловч ард нь
// ямар ч өгөгдөл байгаагүй — хуудас ачаалах бүрд 42.5 цагаас эхлээд өсдөг
// чимэглэл байв. Энэ хүснэгт түүнийг бодит болгоно.
//
// Цагийг ЭХЛЭХ/ДУУСАХ мөчөөр хадгална, урьдчилан тооцсон дүнгээр биш:
// сервер талд үргэлж дахин тооцоолж чадах ёстой (клиентийн цаг найдваргүй,
// мөн маргаан гарвал баримт хэрэгтэй).
model TimeEntry {
  id         String   @id @default(uuid())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String

  startedAt DateTime
  // null = яг одоо ажиллаж байгаа тоолуур. Нэг гэрээнд нэг л ийм мөр байна
  // (route түүнийг хангана).
  endedAt   DateTime?
  note      String?

  createdAt DateTime @default(now())

  @@index([contractId])
  // Ажиллаж буй тоолуурыг хурдан олох — endedAt = null-ээр шүүнэ.
  @@index([contractId, endedAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// ── Disputes (FR-7) ──

model Dispute {
  id          String        @id @default(uuid())
  milestone   Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String        @unique
  openedBy    User          @relation(fields: [openedById], references: [id])
  openedById  String
  reason      String
  status      DisputeStatus @default(OPEN)
  resolution  String? // "FREELANCER" | "CLIENT" | "SPLIT"
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

// ── Reviews (FR-8) ──

model Review {
  id         String   @id @default(uuid())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  revieweeId String
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([contractId, reviewerId])
  @@index([revieweeId])
}

// ── Notifications ──

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // "job" | "message" | "payment" | "system" | "invite" | "review"
  text      String
  link      String? // жишээ нь "messages" — эх сурвалж руу шилжих frontend page
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Messages ──
// 1:1 харилцан яриа. Хэн эхлүүлснээс үл хамааран давхардуулахгүйн тулд
// userAId/userBId-г үргэлж canonical (жижиг ID эхэндээ) дараалалтай хадгална
// (@@unique-ийг л биелүүлэхийн тулд бус — application код бүхэлдээ үүнийг
// хүлээж ажилладаг тул canonical order-ийг бусад route-д давхар мөрдөнө).
model Conversation {
  id        String    @id @default(uuid())
  userA     User      @relation("ConversationsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userAId   String
  userB     User      @relation("ConversationsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  userBId   String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  text           String       @default("")
  // FR-2.1: файл хавсаргасан зурвас (текстгүй байж болно). fileType нь
  // frontend-д зураг/PDF/zip-г ялгаж харуулахад ашиглагдана.
  fileUrl        String?
  fileName       String?
  fileType       String?
  fileSize       Int?
  readAt         DateTime?
  // NFR-3 / FR-5.2: гэрээний өмнөх чатад утас/имэйл мэдээлэл илэрвэл
  // true — зурвасыг хаадаггүй (чат түүх маргааны нотолгоо тул устгагдахгүй),
  // зөвхөн frontend анхааруулга харуулахад хэрэглэнэ.
  flagged        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}