# ── Өгөгдлийн сан (PostgreSQL) ──
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/kreativ_db"

# ── JWT нууц түлхүүрүүд (дор хаяж 16 тэмдэгт, санамсаргүй) ──
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_32_BYTE_HEX"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_32_BYTE_HEX"

# ── Token хугацаа ──
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# ── Сервер ──
PORT=4000
NODE_ENV=development

# ── Google OAuth (заавал биш — тохируулаагүй бол "Continue with Google" 501 буцаана) ──
# Google Cloud Console-оос авах: README.md-ийн "Google OAuth тохируулах" хэсгийг үзнэ үү
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# Login амжилттай болсны дараа хэрэглэгчийг эндрүү redirect хийнэ (frontend)
FRONTEND_URL="http://localhost:5174"