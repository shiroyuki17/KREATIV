# ── Өгөгдлийн сан (PostgreSQL) ──
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# Локал DB-г хамгийн хялбараар асаах: repo-гийн үндэс дээр
#   docker compose up -d
# Энэ нь 5433 порт дээр Postgres гаргана (5432 биш — машин дээр өөр
# Postgres ажиллаж байвал мөргөлдөхгүйн тулд). Дараа нь:
#   npm --prefix backend run prisma:migrate && npm --prefix backend run seed
DATABASE_URL="postgresql://postgres:password@localhost:5433/kreativ_db"

# ── JWT нууц түлхүүрүүд (дор хаяж 16 тэмдэгт, санамсаргүй) ──
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_32_BYTE_HEX"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_32_BYTE_HEX"

# ── Token хугацаа ──
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# ── Сервер ──
PORT=4100
NODE_ENV=development

# Цагийн бүртгэлийн "өдөр" аль бүсээр тоологдох вэ. Гэрээ эхлэхэд тоолуур
# автоматаар асч, өдөр бүр локал шөнө дунд таслагдана. Сервер UTC-ээр
# ажилладаг үед үүнгүйгээр UB-ийн орой 08:00 цагт таслагдана.
TIME_ZONE=Asia/Ulaanbaatar

# ── Google OAuth (заавал биш — тохируулаагүй бол "Continue with Google" 501 буцаана) ──
# Google Cloud Console-оос авах: README.md-ийн "Google OAuth тохируулах" хэсгийг үзнэ үү
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4100/auth/google/callback"

# Login амжилттай болсны дараа хэрэглэгчийг эндрүү redirect хийнэ (frontend)
FRONTEND_URL="http://localhost:5173"

# ── Anthropic Claude API (заавал биш — тохируулаагүй бол /ai/* 503 буцааж,
#    ChatWidget локал rule-based хариулт руугаа автоматаар унана) ──
# Түлхүүрээ https://console.anthropic.com → API Keys хэсгээс өөрөө үүсгэнэ.
# Загварыг backend/src/lib/ai.js дотор MODEL тогтмолоор солино.
ANTHROPIC_API_KEY=""

# ── QPay Merchant API v2 (заавал биш — тохируулаагүй бол payment.routes.js
#    демо горимд ажиллаж, хуурамч QR + өөрөө "төлсөн" гэж мэдэгдэх урсгал руу
#    унана. Тав хоёулаа бөглөгдсөн үед л жинхэнэ горим асна.) ──
# Мерчант эрхээ QPay-ээс авна. Sandbox болон production BASE_URL өөр өөр.
QPAY_BASE_URL=""
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
# ⚠️ Энэ хаяг интернэтээс ХАНДАХ БОЛОМЖТОЙ байх ёстой — QPay энэ рүү webhook
# илгээнэ. localhost ажиллахгүй; dev дээр ngrok/cloudflared туннел ашиглана.
QPAY_CALLBACK_URL=""

# ── Объект хадгалалт (заавал биш — S3-нийцтэй: AWS S3, Cloudflare R2,
#    Backblaze B2, MinIO) ──
# Тохируулаагүй бол файлууд backend/uploads/ дотор ДИСК дээр хадгалагдана.
# ⚠️ Render/Railway зэрэг контейнер hosting дээр диск нь ТҮР ЗУУРЫНХ —
# deploy эсвэл restart болгонд бүх аватар, чатын хавсралт УСТАНА. Production-д
# доорх гурвыг (bucket + түлхүүр хоёр) заавал бөглөнө.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS S3 бол бүсээ (жишээ нь "eu-central-1"). R2 бол "auto" гэж үлдээнэ.
S3_REGION="auto"
# AWS бус нийлүүлэгчийн эндпойнт. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# Файлыг нийтэд уншуулах хаяг (CDN/custom domain). Хоосон бол автоматаар угсарна.
S3_PUBLIC_URL=""

# ── Stripe (заавал биш — escrow deposit + Pro захиалга) ──
# Test mode түлхүүр нь sk_test_... — жинхэнэ мөнгө хөдлөхгүй.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=""
# Webhook signing secret. `stripe listen` эсвэл Dashboard → Webhooks-оос авна.
# ⚠️ Үүнгүйгээр webhook route нь БҮХ хүсэлтийг татгалзана — гарын үсэг
# шалгаагүй webhook нь хэн ч дурын төлбөрийг "төлөгдсөн" болгож чадна.
STRIPE_WEBHOOK_SECRET=""
# Pro багцын Price ID-ууд: Dashboard → Products → Pro → Pricing (price_...).
# ⚠️ Product ID (prod_...) БИШ — Checkout нь Price-аар ажилладаг.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# ── Төлбөрийн провайдер ──
# 'auto' (өгөгдмөл) = тохируулагдсаныг нь сонгоно (Stripe > QPay > демо).
# 'stripe' эсвэл 'qpay' гэж шууд заавал болно.
PAYMENT_PROVIDER="auto"

# ⚠️ Демо төлбөр нь ЯМАР Ч МӨНГӨГҮЙГЭЭР үлдэгдэл үүсгэдэг. production-д
# зөвхөн энэ тугийг САНААТАЙГААР асаасан үед л ажиллана; үгүй бол
# төлбөрийн route-ууд 503 буцаана.
ALLOW_DEMO_PAYMENTS="false"

# ── Google Gemini (заавал биш — prompt-оор ажил хайх) ──
# Түлхүүр: https://aistudio.google.com/api-keys
# Тохируулаагүй бол /ai/job-search нь ур чадвар/категорийн таних
# түлхүүр үгийн хайлт руугаа автоматаар унана (хэрэглэгч хоосон дэлгэц харахгүй).
GEMINI_API_KEY=""
# Загвар. gemini-2.5-flash нь энэ ажилд хямд бөгөөд хангалттай хурдан.
GEMINI_MODEL="gemini-2.5-flash"
# Нэг хэрэглэгч ӨДӨРТ хэдэн AI хайлт хийж болох вэ (зардлын хамгаалалт).
AI_SEARCH_DAILY_LIMIT=40

# ── Админ акаунт (зөвхөн production seed-д) ──
# NODE_ENV=production үед seed нь демо акаунтуудыг ОГТ үүсгэхгүй (тэдгээр нь
# "password123" нууц үгтэй, энэ repo нийтэд нээлттэй). Админ зөвхөн эдгээр
# хоёуланг өгсөн үед үүснэ. Хүчтэй, санамсаргүй нууц үг ашиглана уу.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
